#!/bin/bash
set -eo pipefail

# Print help message
usage() {
    echo "Usage:"
    echo "  $0 <user-allowlist|admin-allowlist> <production|staging|s3://bucket> <edit|list|add|remove> [username]"
    echo "  $0 summarize [production|staging|s3://bucket]"
    echo ""
    echo "Allowlists:"
    echo "  user-allowlist   User allowlist file (github-user-allowlist.txt)"
    echo "  admin-allowlist  Admin allowlist file (github-admin-allowlist.txt)"
    echo ""
    echo "Environments:"
    echo "  production  Uses gs://llm-d-benchmarks"
    echo "  staging     Uses gs://llm-d-benchmarks-staging"
    echo "  s3://bucket An S3-compatible Results Store bucket (RESULTS_STORE_BACKEND=s3), via the"
    echo "              'aws' CLI. Uses RESULTS_STORE_S3_ENDPOINT and RESULTS_STORE_S3_REGION when set,"
    echo "              and AWS credentials from the environment or an AWS CLI profile."
    echo ""
    echo "Actions:"
    echo "  edit    Open the allowlist file in \$EDITOR and save changes on exit (fails if empty)."
    echo "  list    Print the list of usernames to stdout."
    echo "  add     Add a username to the end of the allowlist (errors if duplicate)."
    echo "  remove  Remove a username from the allowlist (errors if not found)."
    exit 1
}

# Runs an 'aws' CLI command (s3 or s3api) against an S3-compatible bucket, with the same
# endpoint and region settings as the Prism server.
aws_cli() {
    if ! command -v aws &> /dev/null; then
        echo "Error: The 'aws' CLI is required for s3:// buckets." >&2
        return 1
    fi
    local args=()
    if [ -n "${RESULTS_STORE_S3_ENDPOINT:-}" ]; then args+=(--endpoint-url "$RESULTS_STORE_S3_ENDPOINT"); fi
    if [ -n "${RESULTS_STORE_S3_REGION:-}" ]; then args+=(--region "$RESULTS_STORE_S3_REGION"); fi
    aws ${args[@]+"${args[@]}"} "$@"
}

# Read an allowlist object (gs:// or s3://) into a destination file.
# Treats missing objects (404 / no matching URLs) as empty, but fails loudly on
# auth, Context-Aware Access, permission, or network errors to prevent silent
# empty output or accidental allowlist overwrites.
read_allowlist() {
    local uri="$1"
    local dest_file="$2"
    local err_file
    err_file=$(mktemp)

    local rc=0
    if [[ "$uri" == s3://* ]]; then
        aws_cli s3 cp "$uri" - > "$dest_file" 2> "$err_file" || rc=$?
    elif command -v gcloud &> /dev/null; then
        gcloud storage cat "$uri" > "$dest_file" 2> "$err_file" || rc=$?
    elif command -v gsutil &> /dev/null; then
        gsutil cat "$uri" > "$dest_file" 2> "$err_file" || rc=$?
    else
        rm -f "$err_file"
        echo "Error: Neither 'gcloud' nor 'gsutil' CLI is available." >&2
        return 1
    fi

    if [ "$rc" -eq 0 ]; then
        rm -f "$err_file"
        return 0
    fi

    # A missing object is an empty list. The last pattern is the AWS CLI's missing-object
    # error, which it also prints for a missing bucket, so for s3:// the bucket must exist.
    local missing=false
    if grep -Eiq "matched no objects|No URLs matched|No such object|\(404\) when calling the HeadObject" "$err_file"; then
        missing=true
        if [[ "$uri" == s3://* ]]; then
            local s3_bucket="${uri#s3://}"
            aws_cli s3api head-bucket --bucket "${s3_bucket%%/*}" > /dev/null 2>> "$err_file" || missing=false
        fi
    fi
    if [ "$missing" = true ]; then
        : > "$dest_file"
        rm -f "$err_file"
        return 0
    fi

    echo "Error: Failed to read allowlist from ${uri}:" >&2
    cat "$err_file" >&2
    rm -f "$err_file"
    return 1
}

# Helper for summarize command
print_allowlist() {
    local bucket="$1"
    local filename="$2"
    local list_type="$3"
    local env="$4"
    
    # A bare name is a GCS bucket; s3:// buckets are passed with their scheme.
    if [[ "$bucket" != s3://* ]]; then bucket="gs://${bucket}"; fi

    local temp_out
    temp_out=$(mktemp)
    if ! read_allowlist "${bucket}/prism-iam/${filename}" "$temp_out"; then
        rm -f "$temp_out"
        exit 1
    fi
    
    echo "${list_type} ${env}:"
    if [ -s "$temp_out" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            # Skip empty or whitespace-only lines
            if [[ ! -z "${line// }" ]]; then
                echo "  - ${line}"
            fi
        done < "$temp_out"
    else
        echo "  []"
    fi
    rm -f "$temp_out"
    echo ""
}

# Check for summarize command
if [ "$1" == "summarize" ]; then
    ENV="$2"
    case "$ENV" in
        "")
            print_allowlist "llm-d-benchmarks-staging" "github-user-allowlist.txt" "user-allowlist" "staging"
            print_allowlist "llm-d-benchmarks-staging" "github-admin-allowlist.txt" "admin-allowlist" "staging"
            print_allowlist "llm-d-benchmarks" "github-user-allowlist.txt" "user-allowlist" "production"
            print_allowlist "llm-d-benchmarks" "github-admin-allowlist.txt" "admin-allowlist" "production"
            ;;
        staging)
            print_allowlist "llm-d-benchmarks-staging" "github-user-allowlist.txt" "user-allowlist" "staging"
            print_allowlist "llm-d-benchmarks-staging" "github-admin-allowlist.txt" "admin-allowlist" "staging"
            ;;
        production)
            print_allowlist "llm-d-benchmarks" "github-user-allowlist.txt" "user-allowlist" "production"
            print_allowlist "llm-d-benchmarks" "github-admin-allowlist.txt" "admin-allowlist" "production"
            ;;
        s3://*)
            S3_BUCKET="${ENV#s3://}"
            print_allowlist "s3://${S3_BUCKET%%/*}" "github-user-allowlist.txt" "user-allowlist" "$ENV"
            print_allowlist "s3://${S3_BUCKET%%/*}" "github-admin-allowlist.txt" "admin-allowlist" "$ENV"
            ;;
        *)
            echo "Error: Unknown environment '$ENV' for summarize. Must be 'production', 'staging' or 's3://bucket' (or empty)." >&2
            exit 1
            ;;
    esac
    exit 0
fi

# Check minimum argument count for standard commands
if [ "$#" -lt 3 ]; then
    usage
fi

LIST_TYPE="$1"
ENV="$2"
ACTION="$3"
USERNAME="$4" # Required for add/remove

# 1. Resolve Bucket
case "$ENV" in
    production)
        BUCKET="gs://llm-d-benchmarks"
        ;;
    staging)
        BUCKET="gs://llm-d-benchmarks-staging"
        ;;
    s3://*)
        # The allowlists live at the bucket root, whatever the store's prefix.
        S3_BUCKET="${ENV#s3://}"
        BUCKET="s3://${S3_BUCKET%%/*}"
        ;;
    *)
        echo "Error: Unknown environment '$ENV'. Must be 'production', 'staging' or 's3://bucket'." >&2
        usage
        ;;
esac

# 2. Resolve Filename
case "$LIST_TYPE" in
    user-allowlist)
        FILENAME="github-user-allowlist.txt"
        ;;
    admin-allowlist)
        FILENAME="github-admin-allowlist.txt"
        ;;
    *)
        echo "Error: Unknown allowlist type '$LIST_TYPE'. Must be 'user-allowlist' or 'admin-allowlist'." >&2
        usage
        ;;
esac

ALLOWLIST_URI="${BUCKET}/prism-iam/${FILENAME}"

# Check action specific requirements
if [[ "$ACTION" == "add" || "$ACTION" == "remove" ]]; then
    if [ -z "$USERNAME" ]; then
        echo "Error: Action '$ACTION' requires a username." >&2
        usage
    fi
fi

# Create a temporary file that will be deleted on exit
TEMP_FILE=$(mktemp)
trap 'rm -f "$TEMP_FILE"' EXIT

# Fetch the current file. If it doesn't exist, we treat it as empty or create it.
fetch_file() {
    read_allowlist "$ALLOWLIST_URI" "$TEMP_FILE" || exit 1
}

upload_file() {
    if [[ "$ALLOWLIST_URI" == s3://* ]]; then
        aws_cli s3 cp "$TEMP_FILE" "$ALLOWLIST_URI" --content-type text/plain --only-show-errors
    elif command -v gcloud &> /dev/null; then
        gcloud storage cp "$TEMP_FILE" "$ALLOWLIST_URI"
    elif command -v gsutil &> /dev/null; then
        gsutil cp "$TEMP_FILE" "$ALLOWLIST_URI"
    else
        echo "Error: Neither 'gcloud' nor 'gsutil' CLI is available." >&2
        exit 1
    fi
}

case "$ACTION" in
    list)
        fetch_file
        cat "$TEMP_FILE"
        ;;
        
    edit)
        fetch_file
        # Default editor to vi if EDITOR is not set
        EDITOR_BIN="${EDITOR:-vi}"
        
        # Calculate initial checksum to check if modified
        INITIAL_MD5=$(md5sum "$TEMP_FILE" | cut -d' ' -f1)
        
        # Open in editor
        $EDITOR_BIN "$TEMP_FILE"
        
        # Fails fatally if file is empty
        if [ ! -s "$TEMP_FILE" ]; then
            echo "Error: The file is empty after editing. Aborting upload to prevent lockouts." >&2
            exit 1
        fi
        
        FINAL_MD5=$(md5sum "$TEMP_FILE" | cut -d' ' -f1)
        
        if [ "$INITIAL_MD5" != "$FINAL_MD5" ]; then
            echo "Changes detected. Uploading to $ALLOWLIST_URI..."
            upload_file
            echo "Successfully updated $ALLOWLIST_URI."
        else
            echo "No changes detected."
        fi
        ;;
        
    add)
        fetch_file
        # Check if username already exists in the file (exact match per line)
        if grep -Fqx "$USERNAME" "$TEMP_FILE"; then
            echo "Error: User '$USERNAME' is already in the allowlist." >&2
            exit 1
        fi
        
        # Add username
        echo "$USERNAME" >> "$TEMP_FILE"
        upload_file
        echo "Successfully added '$USERNAME' to $ALLOWLIST_URI."
        ;;
        
    remove)
        fetch_file
        # Check if username exists
        if ! grep -Fqx "$USERNAME" "$TEMP_FILE"; then
            echo "Error: User '$USERNAME' was not found in the allowlist." >&2
            exit 1
        fi
        
        # Remove username (writing back all lines except the matching one)
        CLEANED_FILE=$(mktemp)
        grep -Fvx "$USERNAME" "$TEMP_FILE" > "$CLEANED_FILE" || true
        mv "$CLEANED_FILE" "$TEMP_FILE"
        
        upload_file
        echo "Successfully removed '$USERNAME' from $ALLOWLIST_URI."
        ;;
        
    *)
        echo "Error: Unknown action '$ACTION'. Must be edit, list, add, or remove." >&2
        usage
        ;;
esac
