{
  "name": "prism",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "prism-results": "./skills/prism-results/scripts/prism.mjs"
  },
  "scripts": {
    "dev": "concurrently \"tsx watch server/server.js\" \"vite --host\"",
    "build": "vite build",
    "start": "tsx server/server.js",
    "prism": "tsx cli/prism.ts",
    "build:cli": "esbuild cli/prism.ts --bundle --platform=node --target=node20 --format=esm --legal-comments=none --outfile=skills/prism-results/scripts/prism.mjs --banner:js=\"#!/usr/bin/env node\n// Copyright 2026 Google LLC\n// SPDX-License-Identifier: Apache-2.0\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "update-metrics": "python3 tools/update_arena_scores.py",
    "artifactregistry-login": "npm_config_registry=https://registry.npmjs.org npx google-artifactregistry-auth",
    "zipline": "rm -f zipline-upload.zip && npm run build && zip -r zipline-upload.zip dist/*"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@google-cloud/storage": "^7.21.0",
    "@tailwindcss/vite": "^4.1.17",
    "boring-avatars": "^2.0.4",
    "clsx": "^2.1.1",
    "compression": "^1.7.4",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "fflate": "^0.8.3",
    "google-auth-library": "^9.4.1",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.4.1",
    "tailwind-merge": "^3.4.0",
    "tsx": "^4.19.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.11.24",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.5.0",
    "vite": "^7.2.4",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "path-to-regexp": "0.1.13"
  }
}
